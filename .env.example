# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# EKAFY MariaDB Connection
DB_HOST=ekafy-mariadb
DB_PORT=3306
DB_USER=ekafy_admin
DB_PASSWORD=change_me_strong_password
DB_NAME=db_tenant_odf_voucher
DATABASE_URL=mysql://ekafy_admin:change_me_strong_password@ekafy-mariadb:3306/db_tenant_odf_voucher

# Authentication (JWT)
JWT_SECRET=replace_with_64_char_random_hex_secret
JWT_EXPIRES_IN=12h

# Initial Admin Bootstrap (created only when users table has 0 admins)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Operations Administrator
SEED_ADMIN_PASSWORD=ChangeMeNow123!

# Voucher Defaults
DEFAULT_CURRENCY=USD
